# ETSI Agent Framework 环境配置
# 复制此文件为 .env 并填入真实值；不要提交 .env。

# --- Anthropic 兼容 API ---
ANTHROPIC_BASE_URL=YOUR_BASE_URL_HERE
ANTHROPIC_API_KEY=YOUR_KEY_HERE
ANTHROPIC_MODEL=YOUR_MODEL_HERE

# --- 工作区（可选）---
# ETSI_WORKSPACE=D:/Auto-TEST/run_001
# SKILLS_ROOT=./skills
# AUTO_TEST_ROOT=D:/Auto-TEST

# --- 本机工具映射（可选）---
# 值必须是本机 path-mapping JSON 文件路径；不要修改项目内的
# skills/path-mapping.json，也不要把私人机器路径提交到仓库。
# PATH_MAPPING=C:/Users/<user>/AppData/Local/etsi-agent/path-mapping.private.json

# --- 流量智能分析（可选）---
# auto 在 A/B 验证完成前固定使用 direct_tshark；显式选择 EasyTshark 时失败仍会回退。
TRAFFIC_ANALYZER_BACKEND=auto
TRAFFIC_AI_PAYLOAD_POLICY=metadata_only
TRAFFIC_MAX_STREAM_SAMPLE_BYTES=4096
TRAFFIC_EASYTSHARK_TIMEOUT_SECONDS=1800
# 可直接配置，也可在私有 PATH_MAPPING 中配置 TOOL.EASYTSHARK_ANALYZER。
# TRAFFIC_EASYTSHARK_PATH=D:/ETSI/tools/easytshark/easytshark-analyzer.exe

# --- MCP（可选）---
# BURP_MCP_TOKEN=YOUR_BURP_MCP_TOKEN_HERE
# BURP_MCP_HOST=127.0.0.1
# BURP_MCP_PORT=9876
